# --- Database ---
# Local: mongodb://127.0.0.1:27017/buggedout
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/buggedout?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/buggedout

# --- Auth.js ---
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Required for local dev and any non-Vercel host; Vercel deployments trust the host automatically.
AUTH_TRUST_HOST=true

# Optional. Only needed to build absolute links (password-reset emails) outside a
# request — a normal request reads the origin from its own headers.
# AUTH_URL=https://buggedout.com

# --- Virtual coin economy (free coins only, no real money) ---
SIGNUP_BONUS_COINS=1000
DAILY_BONUS_COINS=100

# --- Cron ---
# Guards /api/cron/* (the auto-lock sweep). Vercel Cron sends it as
# `Authorization: Bearer <secret>`. Leave blank locally — the route then only
# answers outside production. Generate with: npx auth secret
CRON_SECRET=

# --- Seed (scripts/seed.ts) ---
# Read only by `npm run seed`. Leave unset locally and the seed uses the
# defaults printed in the README; set them for anything reachable from the
# internet, because those defaults are written down in a public file.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=
# SEED_PLAYER_PASSWORD=

# --- Tests ---
# Optional. Point it at a MongoDB *replica set* to run the suite against your
# own database instead of the one mongodb-memory-server downloads and starts.
# MONGODB_TEST_URI=
